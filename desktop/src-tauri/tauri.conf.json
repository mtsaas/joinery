{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Joinery",
  "version": "0.2.1",
  "identifier": "com.mtsaas.joinery",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Joinery",
        "width": 1400,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundThrottling": "disabled",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws: wss: http://localhost:* https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Design SQL databases on a canvas",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_THE_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/mtsaas/joinery/releases/download/desktop-updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
